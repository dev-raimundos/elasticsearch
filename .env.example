# Exemplo publico: gere outra senha antes de utilizar.
ELASTIC_PASSWORD=83d0964b586feeb993611ec61f11fc9ad40804e5bdc93a923978f7cbfc552673
# No servidor, configure ES_BIND_IP=100.64.10.1 se esse IP pertencer ao host.
ES_BIND_IP=127.0.0.1
ES_PORT=9200
# IPv4 de acesso incluido no certificado, alem de 127.0.0.1.
ES_CERT_IP=100.64.10.1
# Diretorio de dados no servidor Linux. Para Windows/local, use ./data.
ES_DATA_DIR=/home/docker-data/elasticsearch
# Snapshots em diretorio separado dos dados ativos.
ES_BACKUP_DIR=./backups
ES_HEAP_SIZE=2g
ES_MEMORY_LIMIT=4g

# Kibana: senha tecnica de kibana_system (nao usar para login no navegador).
KIBANA_PASSWORD=cd630a5122af978b61fcb86d3ca0586f5c1ef30a4b17ba01f59dea6524f8409a
KIBANA_BIND_IP=100.64.10.1
KIBANA_PORT=5601
KIBANA_PUBLIC_URL=http://100.64.10.1:5601
# Para dominio HTTPS do Tunnel, use URL https://... e secure cookies true.
KIBANA_SECURE_COOKIES=false
KIBANA_MEMORY_LIMIT=2g
